{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] && [ -x \"$CLAUDE_PLUGIN_ROOT\"/scripts/orchestrator-priming.py ]; then exec \"$CLAUDE_PLUGIN_ROOT\"/scripts/orchestrator-priming.py; elif [ -n \"${STRAW_BOSS_PLUGIN_ROOT:-}\" ] && [ -x \"$STRAW_BOSS_PLUGIN_ROOT\"/scripts/orchestrator-priming.py ]; then exec \"$STRAW_BOSS_PLUGIN_ROOT\"/scripts/orchestrator-priming.py; elif [ -x \"$HOME\"/.gemini/config/plugins/straw-boss/scripts/orchestrator-priming.py ]; then exec \"$HOME\"/.gemini/config/plugins/straw-boss/scripts/orchestrator-priming.py; fi; cat >/dev/null; printf '%s\\n' '{\"systemMessage\":\"straw-boss: CLAUDE_PLUGIN_ROOT is unset or does not contain scripts/orchestrator-priming.py, so the orchestrator priming hook was skipped. Restart this session to reload plugin roots.\"}'",
            "timeout": 10,
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] && [ -x \"$CLAUDE_PLUGIN_ROOT\"/scripts/dispatched-agent-stop-guard.py ]; then exec \"$CLAUDE_PLUGIN_ROOT\"/scripts/dispatched-agent-stop-guard.py; elif [ -n \"${STRAW_BOSS_PLUGIN_ROOT:-}\" ] && [ -x \"$STRAW_BOSS_PLUGIN_ROOT\"/scripts/dispatched-agent-stop-guard.py ]; then exec \"$STRAW_BOSS_PLUGIN_ROOT\"/scripts/dispatched-agent-stop-guard.py; elif [ -x \"$HOME\"/.gemini/config/plugins/straw-boss/scripts/dispatched-agent-stop-guard.py ]; then exec \"$HOME\"/.gemini/config/plugins/straw-boss/scripts/dispatched-agent-stop-guard.py; fi; cat >/dev/null; printf '%s\\n' '{\"systemMessage\":\"straw-boss: CLAUDE_PLUGIN_ROOT is unset or does not contain scripts/dispatched-agent-stop-guard.py, so the dispatched-agent stop guard was skipped. Restart this session to reload plugin roots.\"}'",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand "
          },
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] && [ -x \"$CLAUDE_PLUGIN_ROOT\"/scripts/context-renewal-guard.py ]; then exec \"$CLAUDE_PLUGIN_ROOT\"/scripts/context-renewal-guard.py; elif [ -n \"${STRAW_BOSS_PLUGIN_ROOT:-}\" ] && [ -x \"$STRAW_BOSS_PLUGIN_ROOT\"/scripts/context-renewal-guard.py ]; then exec \"$STRAW_BOSS_PLUGIN_ROOT\"/scripts/context-renewal-guard.py; elif [ -x \"$HOME\"/.gemini/config/plugins/straw-boss/scripts/context-renewal-guard.py ]; then exec \"$HOME\"/.gemini/config/plugins/straw-boss/scripts/context-renewal-guard.py; fi; cat >/dev/null; printf '%s\\n' '{\"systemMessage\":\"straw-boss: CLAUDE_PLUGIN_ROOT is unset or does not contain scripts/context-renewal-guard.py, so the context renewal guard was skipped. Restart this session to reload plugin roots.\"}'",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ]
  }
}
